<Window x:Class="GigaNigaGame.Starting_Screen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GigaNigaGame"
        mc:Ignorable="d"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen"
        Title="Starting_Screen" Height="450" Width="400">
    <Grid>
        <Grid.ColumnDefinitions>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="112.5"/>
            <RowDefinition/>
            <RowDefinition Height="132.955"/>
        </Grid.RowDefinitions>
        <TextBox Text="Press Esc At any time to exit the game" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" IsReadOnly="True" BorderThickness="0"/>
        <TextBox Text="Enter Name" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="50" IsReadOnly="True" BorderThickness="0"/>
        <TextBox
        x:Name="NameTextBox"
        Grid.Row="1"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0, 0, 0, 25"
        FontSize="24"
        Width="500"
        HorizontalContentAlignment="Center"
        BorderThickness="0"
        Background="Transparent"
        Panel.ZIndex="15"
        VerticalContentAlignment="Top"/>

        <!-- Ghost text -->
        <TextBlock
        Grid.Row="1"
        Text="Enter your name..."
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Margin="0, 0, 0, 25"
        Width="500"
        FontSize="24"
        TextAlignment="Center"
        Foreground="Gray"
        IsHitTestVisible="False">

            <TextBlock.Style>
                <Style TargetType="TextBlock">

                    <!-- Hidden by default -->
                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <!-- Show when textbox empty -->
                        <DataTrigger
                        Binding="{Binding Text, ElementName=NameTextBox}"
                        Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>

                    </Style.Triggers>

                </Style>
            </TextBlock.Style>

        </TextBlock>

        <Button Grid.Row="1"
                Content="Start Game"
                HorizontalAlignment="Center"
                Width="300"
                Height="50"
                Margin="0, 0, 0, 30" Click="Button_Click"/>

        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Height="130" Grid.Row="3">
            <StackPanel Orientation="Horizontal" Height="40">
                <TextBox IsReadOnly="True" x:Name="Num1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="25"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="40">
                <TextBox IsReadOnly="True" x:Name="Num2" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="25"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="40">
                <TextBox IsReadOnly="True" x:Name="Num3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="25"/>
            </StackPanel>
        </StackPanel>



    </Grid>
</Window>
